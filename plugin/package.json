{
  "name": "dsh-link",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Link 宿主插件：多设备远程访问网关 + PC 端锁屏",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/lock-ui.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote",
    "mobile",
    "lock"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "profiles": [
        "web",
        "desktop"
      ],
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible (tested)"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dsh-link/protocol": "file:../shared/protocol",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tests/manifest.test.mjs && node tests/lock.test.mjs",
    "clean": "rm -rf lib"
  }
}

{
  "name": "DSH Link",
  "appid": "",
  "description": "管理并使用多台电脑上的 dsh",
  "versionName": "0.1.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
